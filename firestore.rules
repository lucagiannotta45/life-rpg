rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function pairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function areFriends(other) {
      let p = /databases/$(database)/documents/friendships/$(pairId(me(), other));
      return exists(p) && get(p).data.status == 'accepted';
    }
    function shortStr(v, max) { return v is string && v.size() <= max; }

    // NUOVO: controlli sul contenuto del profilo pubblico
    // XP di una statistica: numero intero tra 0 e il massimo del gioco (MAX_XP in game.js)
    function isXp(v) { return v is int && v >= 0 && v <= 100000; }
    // le sei statistiche, ognuna con un valore di XP valido
    function okStats(s) {
      return s is map
        && s.keys().hasOnly(['Vigore', 'Vitalita', 'Intelletto', 'Creativita', 'Animo', 'Legami'])
        && isXp(s.get('Vigore', 0)) && isXp(s.get('Vitalita', 0)) && isXp(s.get('Intelletto', 0))
        && isXp(s.get('Creativita', 0)) && isXp(s.get('Animo', 0)) && isXp(s.get('Legami', 0));
    }
    // aspetto condiviso con gli amici: sfondo sì/no, impronta dello sfondo, lingua, bordo delle finestre e fino a cinque colori (#rrggbb)
    function okLook(l) {
      return l is map
        && l.keys().hasOnly(['bg', 'bgId', 'lang', 'frame', 'winColor', 'inkColor', 'softColor', 'accentColor', 'nameColor'])
        && l.get('frame', 'semplice') in ['nessuno', 'sottile', 'semplice', 'classico']      // bordo delle finestre
        && l.get('bg', false) is bool
        && shortStr(l.get('bgId', ''), 64) && shortStr(l.get('lang', ''), 10)
        && shortStr(l.get('winColor', ''), 7) && shortStr(l.get('inkColor', ''), 7) && shortStr(l.get('softColor', ''), 7)
        && shortStr(l.get('accentColor', ''), 7) && shortStr(l.get('nameColor', ''), 7);
    }

    // dati privati (progressi, impostazioni, missioni, immagini): solo il proprietario
    match /users/{uid}/{doc=**} {
      allow read, write: if signedIn() && me() == uid;
    }

    // profilo pubblico: lo vedono solo il proprietario e i suoi amici
    match /profiles/{uid} {
      allow read: if signedIn() && (me() == uid || areFriends(uid));
      // NUOVO: si controlla anche il CONTENUTO di stats e look (non solo quanti campi hanno),
      // così nessuno può gonfiare il profilo che scaricano gli amici
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'level', 'title', 'stats', 'look', 'code', 'updated'])
        && shortStr(request.resource.data.name, 30)
        && request.resource.data.level is int && request.resource.data.level >= 0 && request.resource.data.level <= 100
        && (!('stats' in request.resource.data) || okStats(request.resource.data.stats))
        && (!('look' in request.resource.data) || okLook(request.resource.data.look))
        && (!('code' in request.resource.data) || shortStr(request.resource.data.code, 12))
        && (!('title' in request.resource.data) || shortStr(request.resource.data.title, 60))
        && (!('updated' in request.resource.data) || request.resource.data.updated is int);
      // NUOVO: il proprietario può cancellare il proprio profilo (prima era impossibile)
      allow delete: if signedIn() && me() == uid;
    }

    // sfondo condiviso (facoltativo): come il profilo, solo il proprietario e i suoi amici
    match /profileBg/{uid} {
      allow read: if signedIn() && (me() == uid || areFriends(uid));
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['data', 'updated'])
        && request.resource.data.data is string && request.resource.data.data.size() < 400000;
      allow delete: if signedIn() && me() == uid;
    }

    // codici amico: si può cercare un codice preciso, ma non elencarli tutti.
    // Solo creazione (mai modifica): è così che l'app si accorge che un codice è già preso.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])          // niente campi estranei
        && request.resource.data.uid == me()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$');                   // solo codici nel formato dell'app
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // amicizie: richiesta "in attesa", accettata solo dall'altra persona
    match /friendships/{pid} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'requestedBy', 'status', 'created', 'fromName', 'fromCode', 'toCode'])
        && request.resource.data.requestedBy == me()
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]                                                    // niente amicizia con sé stessi
        && me() in request.resource.data.members
        && request.resource.data.status == 'pending'
        && pid == pairId(request.resource.data.members[0], request.resource.data.members[1])
        && (!('fromName' in request.resource.data) || shortStr(request.resource.data.fromName, 30))                               // il nome del mittente
        && (!('fromCode' in request.resource.data) || shortStr(request.resource.data.fromCode, 12))                               // resta corto
        && (!('toCode' in request.resource.data) || shortStr(request.resource.data.toCode, 12));
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && me() in resource.data.members && me() != resource.data.requestedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && me() in resource.data.members;
    }

    // ---------- missioni condivise con fino a 3 amici (shared.js) ----------
    // Un documento per missione. Lo leggono e scrivono solo chi l'ha creata (owner) e gli amici invitati.
    //   members: [owner, amico1, amico2, amico3] (serve per la ricerca e per la lettura)
    //   g: { uid: { n: nome, j: ha accettato, a: versione delle regole accettata, d: quando ha fatto la sua parte, s: ha visto l'esito } }
    // Ognuno può cambiare solo la sua parte; nessuno può completare dopo la scadenza (conta l'ora del server).
    // ATTENZIONE: Firebase ha un tetto al numero di espressioni valutate per richiesta. Qui ogni operazione
    // controlla prima quali campi cambiano (il controllo più economico) e poi solo quelli: il resto del documento
    // non può cambiare, quindi resta valido com'era. Gli amici sono al massimo 3: le funzioni con l'indice (1, 2, 3)
    // guardano uno per uno i posti di members, perché nelle regole non esistono i cicli.
    function okTimeOrNull(v) { return v == null || v is int; }
    function okDateOrNull(v) { return v == null || (v is string && v.size() == 10); }
    function okClockOrNull(v) { return v == null || (v is string && v.size() == 5); }
    function okStars(s) {
      return s == null || (s is map && s.keys().hasOnly(['d', 'f']) && s.d is int && s.f is int
        && s.d >= 1 && s.d <= 5 && s.f >= 1 && s.f <= 5);
    }
    // l'amico al posto i di members (1, 2 o 3): c'è, ha accettato, è in sospeso (non ha accettato l'ultima modifica)
    function gAt(o, i) { return o.g[o.members[i]]; }
    function gIn(o, i) { return o.members.size() > i && gAt(o, i).j; }
    function gActive(o, i) { return gIn(o, i) && gAt(o, i).a == o.ver; }
    function anyJoined(o) { return gIn(o, 1) || gIn(o, 2) || gIn(o, 3); }
    // superata: c'è almeno un amico dentro, e tutti (chi l'ha creata e ogni amico dentro) hanno fatto la loro parte, senza modifiche in sospeso
    function gDoneOk(o, i) { return !gIn(o, i) || (gAt(o, i).a == o.ver && gAt(o, i).d != null); }
    function allDone(o) { return anyJoined(o) && o.oDone != null && gDoneOk(o, 1) && gDoneOk(o, 2) && gDoneOk(o, 3); }
    // ancora aperta: nessuno ha abbandonato e non è già superata
    function shOpen(o) { return o.left == '' && !allDone(o); }
    // prima della scadenza (se c'è), con l'ora del server
    function shInTime(o) { return o.dueAt == null || request.time.toMillis() < o.dueAt; }
    function shDueOk(d) { return d.dueAt == null || d.dueAt > request.time.toMillis(); }
    // finita: qualcuno ha abbandonato, è superata, oppure è scaduta
    function shFinal(o) { return !shOpen(o) || !shInTime(o); }
    // l'esito l'ha visto chiunque debba vederlo (chi era in sospeso esce senza fallire e non serve)
    function gSeenOk(o, i) { return !gActive(o, i) || gAt(o, i).s; }
    function allSeen(o) { return gSeenOk(o, 1) && gSeenOk(o, 2) && gSeenOk(o, 3); }
    // un amico appena invitato: nome, e tutto il resto a zero
    function okNewGuest(e) {
      return e is map && e.keys().hasOnly(['n', 'j', 'a', 'd', 's']) && e.keys().size() == 5
        && shortStr(e.n, 30) && e.j == false && e.a == 0 && e.d == null && e.s == false;
    }
    // il posto i di members, se è nuovo (oltre i primi "from" posti, che c'erano già), è un amico vero appena invitato
    function newGuestAt(from, n, i) {
      return n.members.size() <= i || i < from
        || (n.members[i] != me() && okNewGuest(n.g[n.members[i]]) && areFriends(n.members[i]));
    }
    // g e members vanno d'accordo: in g ci sono esattamente gli amici di members (tutti tranne chi l'ha creata)
    function gMatches(n) {
      return n.g is map && n.g.keys().hasOnly(n.members) && !(n.owner in n.g) && n.g.size() == n.members.size() - 1;
    }
    function sharedKeys() {
      return ['v', 'owner', 'ownerName', 'members', 'g', 'title', 'desc', 'rewards', 'penalty', 'stars',
              'dueAt', 'fromAt', 'tz', 'oDue', 'oDueTime', 'oFrom', 'oFromTime', 'ver', 'oDone', 'left', 'seenO', 'created', 'updated'];
    }
    // il contenuto della missione (lo decide chi l'ha creata)
    function okContent(n) {
      return shortStr(n.title, 60) && n.title.size() > 0 && shortStr(n.desc, 500) && shortStr(n.ownerName, 30)
        && okStats(n.rewards) && okStats(n.penalty) && okStars(n.stars)
        && okTimeOrNull(n.dueAt) && okTimeOrNull(n.fromAt) && shortStr(n.tz, 64) && shDueOk(n)
        && okDateOrNull(n.oDue) && okClockOrNull(n.oDueTime) && okDateOrNull(n.oFrom) && okClockOrNull(n.oFromTime);
    }
    // creazione: tutto parte da zero, con da 1 a 3 amici veri
    function shCreate(n) {
      return n.keys().hasOnly(sharedKeys()) && n.keys().size() == 23
        && n.v == 2 && n.owner == me() && n.members is list && n.members[0] == me()
        && n.members.size() >= 2 && n.members.size() <= 4 && gMatches(n)
        && newGuestAt(1, n, 1) && newGuestAt(1, n, 2) && newGuestAt(1, n, 3)
        && okContent(n)
        && n.ver == 1 && n.oDone == null && n.left == '' && n.seenO == false && n.created is int && n.updated is int;
    }

    // ----- modifiche di chi l'ha creata -----
    function shOwnerUpdate(o, n, k) {
      return me() == o.owner && (
        // completare (o annullare) la propria parte
        (k.hasOnly(['oDone', 'updated']) && shOpen(o) && shInTime(o) && okTimeOrNull(n.oDone))
        // abbandonare (solo se almeno un amico è dentro): la missione fallisce per tutti
        || (k.hasOnly(['left', 'updated']) && anyJoined(o) && shOpen(o) && shInTime(o) && n.left == me())
        // segnare di aver visto l'esito
        || (k.hasOnly(['seenO', 'updated']) && n.seenO == true && shFinal(o))
        // modificare la missione; se cambiano XP, penalità o scadenza la versione sale di uno (gli amici dovranno riaccettare)
        || (k.hasOnly(['title', 'desc', 'rewards', 'penalty', 'stars', 'dueAt', 'fromAt', 'tz', 'oDue', 'oDueTime', 'oFrom', 'oFromTime',
                       'ver', 'ownerName', 'updated'])
            && shOpen(o) && shInTime(o) && okContent(n)
            && (k.hasAny(['rewards', 'penalty', 'dueAt']) ? n.ver == o.ver + 1 : (n.ver == o.ver || n.ver == o.ver + 1)))
        // invitare altri amici: vale come modifica, quindi la versione sale di uno (chi è dentro deve riaccettare)
        || (k.hasOnly(['g', 'members', 'ver', 'updated']) && shOpen(o) && shInTime(o)
            && n.ver == o.ver + 1 && n.members.size() > o.members.size() && n.members.size() <= 4
            && n.members[0:o.members.size()] == o.members && gMatches(n)
            && n.g.diff(o.g).changedKeys().size() == 0
            && newGuestAt(o.members.size(), n, 1) && newGuestAt(o.members.size(), n, 2) && newGuestAt(o.members.size(), n, 3))
        // togliere chi non ha risposto: gli inviti senza risposta e chi è in sospeso (non ha accettato l'ultima modifica).
        // Chi è dentro con le regole attuali resta. Se non resta nessuno, la missione torna solo di chi l'ha creata
        || (k.hasOnly(['g', 'members', 'updated']) && n.members.size() >= 1 && n.members[0] == o.owner && gMatches(n)
            && n.g.diff(o.g).addedKeys().size() == 0 && n.g.diff(o.g).changedKeys().size() == 0
            && gRemovedOk(o, n, 1) && gRemovedOk(o, n, 2) && gRemovedOk(o, n, 3))
      );
    }
    // l'amico al posto i, se tolto, non era dentro con le regole attuali (invito senza risposta, oppure in sospeso)
    function gRemovedOk(o, n, i) { return o.members.size() <= i || o.members[i] in n.g || !gActive(o, i); }

    // ----- modifiche di un amico: solo la sua voce in g -----
    function shGuestUpdate(o, n, k) {
      return me() in o.g && (
        // uscire senza fallire: rifiutando l'invito, oppure dopo una modifica non ancora accettata
        (k.hasOnly(['g', 'members', 'updated']) && shOpen(o) && (!o.g[me()].j || o.g[me()].a != o.ver)
          && !(me() in n.g) && n.g.diff(o.g).affectedKeys().hasOnly([me()]) && n.members == o.members.removeAll([me()]))
        // abbandonare: solo dopo aver accettato le regole attuali; la missione fallisce per tutti
        || (k.hasOnly(['left', 'updated']) && o.g[me()].j && o.g[me()].a == o.ver && shOpen(o) && shInTime(o) && n.left == me())
        // tutto il resto cambia solo la propria voce in g
        || (k.hasOnly(['g', 'updated']) && me() in n.g && n.g.diff(o.g).affectedKeys().hasOnly([me()])
            && shGuestEntry(o, o.g[me()], n.g[me()], n.g[me()].diff(o.g[me()]).affectedKeys()))
      );
    }
    function shGuestEntry(o, e, ne, ek) {
      // accettare l'invito (solo se siete ancora amici e prima della scadenza)
      return (ek.hasOnly(['n', 'j', 'a']) && !e.j && shOpen(o) && shInTime(o)
          && ne.j == true && ne.a == o.ver && shortStr(ne.n, 30) && areFriends(o.owner))
        // accettare le regole nuove dopo una modifica
        || (ek.hasOnly(['a']) && e.j && shOpen(o) && shInTime(o) && ne.a == o.ver)
        // completare (o annullare) la propria parte: solo dopo aver accettato le regole attuali
        || (ek.hasOnly(['d']) && e.j && e.a == o.ver && shOpen(o) && shInTime(o) && okTimeOrNull(ne.d))
        // segnare di aver visto l'esito
        || (ek.hasOnly(['s']) && ne.s == true && shFinal(o));
    }
    function shUpdate() {
      let o = resource.data;
      let n = request.resource.data;
      let k = n.diff(o).affectedKeys();
      return o.v == 2 && n.updated is int && (shOwnerUpdate(o, n, k) || shGuestUpdate(o, n, k));
    }
    // eliminare il documento
    function shDelete(o) {
      // chi l'ha creata, finché nessun amico ha accettato (inviti annullati, rifiutati o scaduti)
      return (me() == o.owner && !anyJoined(o))
        // finita, e l'esito l'hanno visto tutti quelli che dovevano vederlo
        || (me() in o.members && shFinal(o) && (me() == o.owner || o.seenO) && allSeen(o));
    }

    // ---------- routine di gruppo con fino a 3 amici (shared-routines.js) ----------
    // Un documento per routine. Lo leggono e scrivono solo chi l'ha creata (owner) e gli amici invitati.
    //   members: [owner, amico1, amico2, amico3]
    //   g: { uid: { n: nome, j: ha accettato, a: versione delle regole accettata, since: giorno del gruppo da cui partecipa } }
    //   k: { AAAAMMGG: { uid: ora del server in cui ha completato la sua parte } }, con il primo giorno del periodo;
    //   lk: il periodo toccato dall'ultima scrittura
    //   freq, n: ogni giorno / settimana / mese ('d', 'w', 'm'), quante volte per periodo (senza: ogni giorno, una volta);
    //   at: da dove si contano i periodi (dopo un cambio), pk: l'ultimo periodo prima di at, nx: il cambio in attesa
    //   (frequenza, volte, giorni e ora dal giorno nx.at; nx.pk come pk)
    // Ognuno segna solo la propria parte, con l'ora del server, e solo vicino a quel periodo (il fuso del gruppo lo conosce
    // l'app: qui si accetta da 14 ore prima della mezzanotte UTC del primo giorno a 38 ore dopo quella dell'ultimo, che
    // copre tutti i fusi; per settimane e mesi l'ultimo giorno è al massimo 6 o 30 giorni dopo il primo).
    // Se la parte è arrivata dopo la scadenza vera, la serie di gruppo non la conta: lo controlla l'app con l'ora del server.
    // (pause: non si usa più; resta permessa perché c'è nei documenti di prima e la scrivono le versioni precedenti dell'app)
    function srBaseKeys() {
      return ['v', 'owner', 'ownerName', 'members', 'g', 'title', 'desc', 'rewards', 'penalty', 'stars', 'days', 'time',
              'start', 'bonus', 'tz', 'ver', 'k', 'lk', 'created', 'updated'];
    }
    function srKeys() { return srBaseKeys().concat(['pause', 'freq', 'n', 'at', 'pk', 'nx']); }
    function srTplKeys() {
      return ['title', 'desc', 'rewards', 'penalty', 'stars', 'days', 'time', 'start', 'pause', 'bonus', 'tz', 'ver', 'ownerName', 'updated',
              'freq', 'n', 'at', 'pk', 'nx'];
    }
    // le regole della routine: cambiandole la versione sale di uno (gli amici dovranno riaccettare)
    function srRuleKeys() { return ['rewards', 'penalty', 'days', 'time', 'freq', 'n', 'at', 'pk', 'nx']; }
    function okDay10(v) { return v is string && v.size() == 10; }
    // frequenza, volte, giorni e ora: i giorni solo ogni giorno (almeno uno), l'ora solo per una volta al giorno
    function srShape(f, times, days, time) {
      return f in ['d', 'w', 'm'] && times is int && times >= 1 && times <= 999
        && days is list && days.size() <= 7 && days.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && (f == 'd' ? days.size() >= 1 : days.size() == 0)
        && okClockOrNull(time) && (time == null || (f == 'd' && times == 1));
    }
    function srNx(x) {
      return x == null || (x is map && x.keys().hasOnly(['at', 'freq', 'n', 'days', 'time', 'pk']) && x.keys().hasAll(['at', 'freq', 'n', 'days'])
        && okDay10(x.at) && srShape(x.freq, x.n, x.days, x.get('time', null)) && (x.get('pk', null) == null || okDay10(x.pk)));
    }
    // il modello della routine (lo decide chi l'ha creata)
    function srTpl(n) {
      return shortStr(n.title, 60) && n.title.size() > 0 && shortStr(n.desc, 500) && shortStr(n.ownerName, 30)
        && okStats(n.rewards) && okStats(n.penalty) && okStars(n.stars)
        && srShape(n.get('freq', 'd'), n.get('n', 1), n.days, n.time)
        && (n.get('at', null) == null || okDay10(n.at)) && (n.get('pk', null) == null || okDay10(n.pk)) && srNx(n.get('nx', null))
        && n.start is string && n.start.size() == 10 && shortStr(n.tz, 64)
        && (n.get('pause', null) == null || (n.pause is map && n.pause.keys().hasOnly(['from', 'until'])
            && n.pause.from is string && n.pause.from.size() == 10 && n.pause.until is string && n.pause.until.size() == 10))
        && (n.bonus == null || (n.bonus is map && n.bonus.keys().hasOnly(['every', 'xp'])
            && n.bonus.every is int && n.bonus.every >= 2 && n.bonus.every <= 100000
            && n.bonus.xp is int && n.bonus.xp >= 1 && n.bonus.xp <= 100000));
    }
    function okNewSrGuest(e) {
      return e is map && e.keys().hasOnly(['n', 'j', 'a', 'since']) && e.keys().size() == 4
        && shortStr(e.n, 30) && e.j == false && e.a == 0 && e.since == '';
    }
    function newSrGuestAt(from, n, i) {
      return n.members.size() <= i || i < from
        || (n.members[i] != me() && okNewSrGuest(n.g[n.members[i]]) && areFriends(n.members[i]));
    }
    function srCreate(n) {
      return n.keys().hasOnly(srKeys()) && n.keys().hasAll(srBaseKeys())
        && n.v == 1 && n.owner == me() && n.members is list && n.members[0] == me()
        && n.members.size() >= 2 && n.members.size() <= 4 && gMatches(n)
        && newSrGuestAt(1, n, 1) && newSrGuestAt(1, n, 2) && newSrGuestAt(1, n, 3)
        && srTpl(n) && n.ver == 1 && n.k == {} && n.lk == '' && n.created is int && n.updated is int;
    }
    // chi può segnare la sua parte: chi l'ha creata, o un amico dentro con le regole attuali
    function srIn(o) { return me() == o.owner || (me() in o.g && o.g[me()].j == true && o.g[me()].a == o.ver); }
    // il giorno "AAAAMMGG" come istante (mezzanotte UTC)
    function srDay(s) { return timestamp.date(int(s[0:4]), int(s[4:6]), int(s[6:8])); }
    // la routine è (o sta per diventare, con il cambio in attesa) settimanale o mensile
    function srHas(o, f) { return o.get('freq', 'd') == f || (o.get('nx', null) != null && o.nx.freq == f); }
    function srDayOpen(s, o) {
      return request.time > srDay(s) - duration.value(14, 'h')
        && (request.time < srDay(s) + duration.value(38, 'h')
          || (srHas(o, 'w') && request.time < srDay(s) + duration.value(182, 'h'))
          || (srHas(o, 'm') && request.time < srDay(s) + duration.value(758, 'h')));
    }
    // segnare (con l'ora del server) o togliere la propria parte di un giorno: cambia solo k[lk][me]
    function srPart(o, n, k) {
      return k.hasOnly(['k', 'lk', 'updated']) && srIn(o)
        && n.lk is string && n.lk.matches('^[0-9]{8}$') && n.k is map && n.lk in n.k
        && n.k.diff(o.k).affectedKeys().hasOnly([n.lk])
        && n.k[n.lk] is map && n.k[n.lk].diff(o.k.get(n.lk, {})).affectedKeys().hasOnly([me()])
        && (!(me() in n.k[n.lk]) || n.k[n.lk][me()] == request.time)
        && srDayOpen(n.lk, o);
    }
    // togliere un giorno vecchio (più di 60 giorni fa), uno per volta: lo può fare chiunque partecipi
    function srPrune(o, n, k) {
      return k.hasOnly(['k', 'lk', 'updated']) && me() in o.members
        && n.lk is string && n.lk.matches('^[0-9]{8}$') && n.k is map
        && n.lk in o.k && !(n.lk in n.k) && n.k.diff(o.k).affectedKeys().hasOnly([n.lk])
        && srDay(n.lk) < request.time - duration.value(60, 'd');
    }
    function srOwnerUpdate(o, n, k) {
      return me() == o.owner && (
        // modificare la routine; se cambiano le regole (XP, penalità, frequenza, volte, giorni, ora) la versione sale di uno
        (k.hasOnly(srTplKeys()) && srTpl(n)
          && (k.hasAny(srRuleKeys()) ? n.ver == o.ver + 1 : (n.ver == o.ver || n.ver == o.ver + 1)))
        // invitare altri amici (chi è già dentro non deve riaccettare: per lui non cambia niente)
        || (k.hasOnly(['g', 'members', 'updated'])
            && n.members.size() > o.members.size() && n.members.size() <= 4
            && n.members[0:o.members.size()] == o.members && gMatches(n)
            && n.g.diff(o.g).changedKeys().size() == 0 && n.g.diff(o.g).removedKeys().size() == 0
            && newSrGuestAt(o.members.size(), n, 1) && newSrGuestAt(o.members.size(), n, 2) && newSrGuestAt(o.members.size(), n, 3))
        // togliere chi non ha risposto: inviti senza risposta e chi è in sospeso (chi è dentro con le regole attuali resta)
        || (k.hasOnly(['g', 'members', 'updated']) && n.members.size() >= 1 && n.members.size() < o.members.size()
            && n.members[0] == o.owner && gMatches(n)
            && n.g.diff(o.g).addedKeys().size() == 0 && n.g.diff(o.g).changedKeys().size() == 0
            && gRemovedOk(o, n, 1) && gRemovedOk(o, n, 2) && gRemovedOk(o, n, 3))
      );
    }
    function srGuestUpdate(o, n, k) {
      return me() in o.g && (
        // uscire (o rifiutare l'invito), quando si vuole: nessuna penalità per nessuno
        (k.hasOnly(['g', 'members', 'updated']) && !(me() in n.g)
          && n.g.diff(o.g).affectedKeys().hasOnly([me()]) && n.members == o.members.removeAll([me()]))
        // tutto il resto cambia solo la propria voce in g
        || (k.hasOnly(['g', 'updated']) && me() in n.g && n.g.diff(o.g).affectedKeys().hasOnly([me()])
            && srGuestEntry(o, o.g[me()], n.g[me()], n.g[me()].diff(o.g[me()]).affectedKeys()))
      );
    }
    function srGuestEntry(o, e, ne, ek) {
      // accettare l'invito (solo se siete ancora amici): da quale giorno del gruppo partecipi
      return (ek.hasOnly(['n', 'j', 'a', 'since']) && !e.j && ne.j == true && ne.a == o.ver && shortStr(ne.n, 30)
          && ne.since is string && ne.since.size() == 10 && areFriends(o.owner))
        // accettare le regole nuove dopo una modifica
        || (ek.hasOnly(['a']) && e.j && ne.a == o.ver);
    }
    function srUpdate() {
      let o = resource.data;
      let n = request.resource.data;
      let k = n.diff(o).affectedKeys();
      return o.v == 1 && n.updated is int
        && (srPart(o, n, k) || srPrune(o, n, k) || srOwnerUpdate(o, n, k) || srGuestUpdate(o, n, k));
    }

    match /sroutines/{rid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.members);
      allow create: if signedIn() && rid.matches('^q[a-z0-9]{6,11}$') && srCreate(request.resource.data);
      allow update: if signedIn() && srUpdate();
      // sciogliere il gruppo: solo chi l'ha creata (agli amici la routine resta, come routine normale)
      allow delete: if signedIn() && resource.data.owner == me();
    }

    match /shared/{sid} {
      // resource == null: il documento non esiste. Leggerlo non rivela niente e permette all'app di accorgersi
      // che è stato eliminato (altrimenti la lettura viene rifiutata e l'app non lo capisce)
      allow read: if signedIn() && (resource == null || me() in resource.data.members);
      allow create: if signedIn() && sid.matches('^s[a-z0-9]{6,30}$') && shCreate(request.resource.data);
      allow update: if signedIn() && shUpdate();
      allow delete: if signedIn() && shDelete(resource.data);
    }
  }
}
